# Copy this file to .env in the project root and fill it in. app/config.py
# reads .env on startup, so PyCharm's Run button picks it up with no extra
# setup. Anything already in your shell environment wins over this file.

# PostgreSQL. Leave this commented out to use the local SQLite file, which is
# what the demo runs on. Uncomment it only once a Postgres server is actually
# running, or startup will fail trying to connect.
# NETSAGE_DATABASE_URL=postgresql+psycopg2://netsage:netsage@localhost:5432/netsage

# Anthropic API key, from console.anthropic.com. With it, diagnoses come
# from Claude; without it the pipeline runs on the local heuristic engine,
# which still works end to end. Every diagnosis records which one ran.
ANTHROPIC_API_KEY=

# Optional overrides
NETSAGE_AI_MODEL=claude-opus-5
NETSAGE_CASE_DIR=./data/cases
